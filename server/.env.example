PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
CLIENT_URL=http://localhost:5173
NODE_ENV=production

# Gemini AI API Keys Configuration (Supports single, multi-key pool, or phase-dedicated)
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Optional: Dedicated keys per phase for independent rate limits (RPM/TPM)
# GEMINI_API_KEY_EXTRACT=your_extract_phase_api_key
# GEMINI_API_KEY_GENERATE=your_generate_phase_api_key
# GEMINI_API_KEY_VERIFY=your_verification_api_key
# GEMINI_API_KEY_RESERVE=your_standby_reserve_api_key

# Optional: Comma-separated pool for automatic failover & borrowing
# GEMINI_API_KEYS=key1,key2,key3,key4
